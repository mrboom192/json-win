---
interface Props {
  current: string;
  parents?: { label: string; href: string }[];
}

const { current, parents = [] } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a>
  {
    parents.map((parent) => (
      <>
        <span class="breadcrumb-separator" aria-hidden="true" />
        <a href={parent.href}>{parent.label}</a>
      </>
    ))
  }
  <span class="breadcrumb-separator" aria-hidden="true"></span>
  <span class="breadcrumb-current" aria-current="page">{current}</span>
</nav>

<script>
  const breadcrumb = document.querySelector<HTMLElement>(".breadcrumb");

  if (breadcrumb) {
    let previousScrollY = window.scrollY;
    let ticking = false;

    const updateBreadcrumb = () => {
      const currentScrollY = Math.max(window.scrollY, 0);
      const scrollingDown = currentScrollY > previousScrollY;

      breadcrumb.classList.toggle(
        "breadcrumb-hidden",
        scrollingDown && currentScrollY > 80,
      );

      previousScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateBreadcrumb);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .breadcrumb {
    position: sticky;
    top: 1rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    max-width: calc(100% - 2 * var(--page-gutter));
    min-height: 40px;
    margin: 0 auto 0;
    padding: 8px 12px;
    border: 1px solid var(--color-text);
    background: var(--color-background);
    box-shadow: 0 2px 3px #0003;
    font-size: var(--text-small);
    line-height: 1.5;
    transition:
      transform 220ms ease,
      opacity 180ms ease;
    will-change: transform;
  }

  .breadcrumb-hidden:not(:focus-within) {
    transform: translateY(calc(-100% - 20px));
    opacity: 0;
    pointer-events: none;
  }

  .breadcrumb a {
    flex-shrink: 0;
    color: var(--color-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .breadcrumb-separator {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-top: 1px solid var(--color-muted);
    border-right: 1px solid var(--color-muted);
    transform: rotate(45deg);
  }

  .breadcrumb-current {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 540px) {
    .breadcrumb-hidden:not(:focus-within) {
      transform: translateY(calc(-100% - 14px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .breadcrumb {
      transition: none;
    }
  }
</style>
