---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'json.win - Jason Nguyen',
	description = 'Portfolio of Jason Nguyen, a computer scientist and full-stack developer building web, mobile, and cloud software.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color: #111111;
		background: #fbfbf8;
		--font-body: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
			sans-serif;
		--font-title: Baskerville, 'Baskerville Old Face', 'Libre Baskerville', Georgia, serif;
		font-family: var(--font-body);
		font-size: 16px;
		font-synthesis: none;
		text-rendering: geometricPrecision;
	}

	* {
		box-sizing: border-box;
		font-weight: 400;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		position: relative;
		background: #fbfbf8;
		color: #111111;
		font-size: 1rem;
	}

	body::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		z-index: 0;
		width: 100%;
		height: 58vh;
		pointer-events: none;
		background:
			linear-gradient(rgba(18, 18, 18, 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(18, 18, 18, 0.045) 1px, transparent 1px);
		background-size: 22px 22px;
		mask-image: linear-gradient(to bottom, #000 0%, #000 42%, transparent 100%);
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 42%, transparent 100%);
	}

	body > * {
		position: relative;
		z-index: 1;
	}

	a {
		color: inherit;
	}

	::selection {
		background: #b8f7d0;
		color: #111111;
	}
</style>
