---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { formatDate, postUrl } from '../lib/posts';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id));
---
<Layout title="Jason Nguyen | json.win" description="Notes and writing by Jason Nguyen.">
  <main class="home">
    <header>
      <h1>Jason Nguyen</h1>
      <nav aria-label="Contact links">
        <a href="mailto:jason.n.nguyen.04@gmail.com">Email</a>
        <a href="https://github.com/mrboom192">GitHub</a>
        <a href="/jason-nguyen-resume.pdf">Resume</a>
      </nav>
    </header>
    <section aria-labelledby="posts-title">
      <h2 id="posts-title">Posts</h2>
      {posts.length ? <ul>{posts.map((post) => <li>
        <a href={postUrl(post.id)}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </li>)}</ul> : <p class="empty">No posts yet.</p>}
    </section>
  </main>
</Layout>
<style>
  .home { width: min(100% - 40px, 680px); margin: 0 auto; padding: 112px 0 80px; }
  h1 { margin: 0; font-size: 36px; line-height: 1.3; overflow-wrap: anywhere; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 24px; font-size: 14px; }
  section { margin-top: 88px; }
  h2 { margin: 0 0 24px; font-size: 18px; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; padding: 20px 0; border-top: 1px solid #e5e5e5; }
  li a { overflow-wrap: anywhere; text-decoration: none; }
  li a:hover { text-decoration: underline; }
  time, .empty { color: #666; font-size: 13px; line-height: 1.8; }
  @media (max-width: 480px) {
    .home { padding-top: 80px; }
    h1 { font-size: 28px; }
    section { margin-top: 64px; }
    li { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
