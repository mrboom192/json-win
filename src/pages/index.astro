---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
const blogs = (await getCollection("blogs", ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
);
---

<Layout
  title="Jason Nguyen | json.win"
  description="Notes and writing by Jason Nguyen."
>
  <main class="home container">
    <header>
      <h1>Jason Nguyen</h1>
      <p class="email meta">jason.n.nguyen.04@gmail.com</p>
      <nav aria-label="Profile links">
        <a href="https://www.linkedin.com/in/jason-nguyen-69aa0a284/"
          >LinkedIn</a
        >
        <a href="https://github.com/mrboom192">GitHub</a>
        <a href="/jason-nguyen-resume.pdf">Resume</a>
        <a href="/notes/">Notes</a>
      </nav>
    </header>
    <section aria-labelledby="posts-title">
      <h2 id="posts-title">Blogs</h2>
      <p class="description">Write ups on topics that I feel proud posting</p>
      {
        blogs.length ? (
          <ul class="post-grid">
            {blogs.map((post) => (
              <li>
                <a
                  class="post-card"
                  href={`/posts/${post.id.split("/").map(encodeURIComponent).join("/")}/`}
                  style={{ "--post-color": post.data.color }}
                >
                  <div class="card-copy">
                    <h3>{post.data.title}</h3>
                    {post.data.description && <p>{post.data.description}</p>}
                  </div>
                  {post.data.titleModel && (
                    <div class="card-model" aria-hidden="true" inert>
                      <title-model-viewer
                        preview
                        src={post.data.titleModel}
                        rotation={post.data.titleModelRotation}
                        zoom={post.data.titleModelZoom}
                        wireframe={String(post.data.titleModelWireframe)}
                        wireframe-style={post.data.titleModelWireframeStyle}
                      />
                    </div>
                  )}
                  <span class="post-number">
                    {post.data.date.toLocaleDateString("en-US", {
                      month: "2-digit",
                      year: "2-digit",
                    })}
                  </span>
                  <svg
                    class="post-chevron"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="m9 6 6 6-6 6" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="meta">No posts yet.</p>
        )
      }
    </section>
  </main>
</Layout>

<script>
  import { whenNearViewport } from "../scripts/viewer-visibility";
  for (const element of document.querySelectorAll<HTMLElement>(
    "title-model-viewer[preview]",
  )) {
    whenNearViewport(element, () => {
      void import("../scripts/title-model-viewer").catch((error) =>
        console.error("Unable to load 3D preview", error),
      );
    });
  }
</script>

<style>
  header {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;

    padding: 5rem 0rem;
  }

  .home {
    --page-width: 42.5rem;
  }

  .email {
    margin: 0.5rem 0 0;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 2rem;
    margin-top: 1rem;
  }

  #posts-title {
    text-align: center;
    margin: 0;
  }

  .description {
    text-align: center;
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .post-number {
    grid-area: number;
    align-self: end;
    color: var(--color-text);
  }

  .post-card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "copy copy copy"
      "number model model";
    grid-template-rows: auto 1fr;
    overflow: hidden;

    height: 100%;
    padding: 1rem;

    background: var(--post-color);
    border: 1px solid #000;

    text-decoration: none;
  }

  .post-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #fff;
    opacity: 0;
    transition: opacity 280ms ease;
  }

  .post-card:focus-visible::before {
    opacity: 0.12;
  }

  .card-copy {
    grid-area: copy;
    position: relative;
    z-index: 1;

    color: #000;
  }

  h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .card-copy p {
    line-height: 1.6;
    overflow-wrap: anywhere;
    font-size: 0.75rem;
    margin: 0.5rem 0;
  }

  .post-chevron {
    position: absolute;
    top: 1rem;
    right: 1rem;

    color: var(--color-text);
  }

  .card-model {
    grid-area: model;
    width: 65%;
    aspect-ratio: 1;
    margin: auto -0.25rem -0.75rem auto;
    pointer-events: none;
    transform-origin: 65% 65%;
    transition: transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card-model title-model-viewer {
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .post-card:hover::before {
      opacity: 0.12;
    }
    .post-card:hover .card-model {
      transform: translateX(-0.25rem) translateY(-0.25rem) scale(1.1);
    }
  }
  @media (max-width: 900px) {
    .post-number {
      align-self: start;
    }

    .post-grid {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }

    .post-card {
      grid-template-columns: auto minmax(0, 2fr) minmax(0, 1fr);
      grid-template-areas: "number copy model";
      grid-template-rows: 1fr;
      gap: 1rem;

      min-height: 9rem;
    }

    .card-model {
      position: absolute;
      right: -50%;
      top: 20%;

      width: 150%;
      aspect-ratio: 1;
    }

    .post-card:hover .card-model {
      transform: translateX(-5%) scale(1.1);
    }
  }

  @media (max-width: 480px) {
    .post-grid {
      gap: 0.75rem;
    }
    .post-card {
      padding: 1rem;
    }

    .card-model {
      position: absolute;
      right: -100%;

      width: 200%;
      aspect-ratio: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card::before,
    .card-model {
      transition: none;
    }
    .post-card:is(:hover, :focus-visible) .card-model {
      transform: none;
    }
  }
</style>
