---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import 'katex/dist/katex.min.css';
import Layout from '../../layouts/Layout.astro';
import { formatDate } from '../../lib/posts';
export const prerender = true;
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} | Jason Nguyen`} description={post.data.description ?? post.data.title}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-separator" aria-hidden="true"></span>
    <span class="breadcrumb-current" aria-current="page">{post.data.title}</span>
  </nav>
  <main class="post">
    <article>
      <header class:list={['post-header', { 'with-image': post.data.image }]}>
        {post.data.image && <Image src={post.data.image} alt={post.data.imageAlt} width={440} class="cover" loading="eager" />}
        <div><h1>{post.data.title}</h1><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div>
      </header>
      <div class="prose"><Content /></div>
    </article>
  </main>
</Layout>
<script>
  const breadcrumb = document.querySelector<HTMLElement>('.breadcrumb');

  if (breadcrumb) {
    let previousScrollY = window.scrollY;
    let ticking = false;

    const updateBreadcrumb = () => {
      const currentScrollY = Math.max(window.scrollY, 0);
      const scrollingDown = currentScrollY > previousScrollY;

      breadcrumb.classList.toggle('breadcrumb-hidden', scrollingDown && currentScrollY > 80);
      previousScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateBreadcrumb);
        ticking = true;
      }
    }, { passive: true });
  }
</script>
<style>
  .breadcrumb { position: sticky; top: 1rem; z-index: 10; display: flex; align-items: center; gap: 0.5rem; width: fit-content; max-width: calc(100% - 40px); min-height: 40px; margin: 10px auto 0; padding: 8px 12px; border: 1px solid #111; background: #fff; box-shadow: 0 2px 3px #0003; font-family: var(--font-body); font-size: 14px; line-height: 1.5; transition: transform 220ms ease, opacity 180ms ease; will-change: transform; }
  .breadcrumb-hidden { transform: translateY(calc(-100% - 20px)); opacity: 0; pointer-events: none; }
  .breadcrumb a { color: #aaa; text-decoration: none; }
  .breadcrumb a:hover { color: #666; }
  .breadcrumb-separator { width: 8px; height: 8px; flex: 0 0 auto; border-top: 1px solid #aaa; border-right: 1px solid #aaa; transform: rotate(45deg); }
  .breadcrumb-current { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .post { width: min(100% - 40px, 680px); margin: 0 auto; padding: 4rem 0 72px; }
  .post-header { display: grid; align-items: center; gap: 32px; margin-bottom: 44px; }
  .with-image { grid-template-columns: 220px minmax(0, 1fr); }
  .cover { width: 100%; height: 220px; object-fit: contain; }
  h1 { margin: 0 0 12px; font-size: 28px; line-height: 1.35; overflow-wrap: anywhere; }
  time { font-size: 13px; color: #555; }
  .prose { font-size: 14px; line-height: 1.8; overflow-wrap: anywhere; }
  .prose :global(h1), .prose :global(h2), .prose :global(h3), .prose :global(h4) { margin: 40px 0 18px; line-height: 1.4; }
  .prose :global(h1), .prose :global(h2) { font-size: 22px; }
  .prose :global(h3) { font-size: 18px; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 22px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 24px; }
  .prose :global(li > ul), .prose :global(li > ol) { margin-bottom: 0; }
  .prose :global(img), .prose :global(video) { display: block; max-width: 100%; height: auto; margin: 30px auto; }
  .prose :global(pre) { max-width: 100%; padding: 20px; overflow-x: auto; font-size: 13px; line-height: 1.65; }
  .prose :global(code) { font-family: inherit; }
  .prose :global(:not(pre) > code) { background: #f1f1f1; padding: 2px 4px; }
  .prose :global(.katex) { font-size: 1em; }
  .prose :global(.katex-display) { display: flex; justify-content: center; margin: 30px 0; overflow-x: auto; overflow-y: hidden; padding-bottom: 4px; text-align: center; }
  .prose :global(.katex-display > .katex) { flex: 0 0 auto; }
  .prose :global(blockquote) { margin: 28px 0; padding-left: 20px; border-left: 2px solid #aaa; color: #555; }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 28px 0; }
  .prose :global(th), .prose :global(td) { border-bottom: 1px solid #ddd; padding: 10px 16px; text-align: left; }
  .prose :global(hr) { border: 0; border-top: 1px solid #ddd; margin: 40px 0; }
  @media (max-width: 540px) {
    .breadcrumb-hidden { transform: translateY(calc(-100% - 14px)); }
    .with-image { grid-template-columns: 1fr; gap: 20px; }
    .cover { width: 180px; height: 180px; }
    h1 { font-size: 24px; }
    .post-header { min-height: 140px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .breadcrumb { transition: none; }
  }
</style>
