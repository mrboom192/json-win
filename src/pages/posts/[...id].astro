---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import "katex/dist/katex.min.css";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../lib/posts";
export const prerender = true;
export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} | Jason Nguyen`}
  description={post.data.description ?? post.data.title}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-separator" aria-hidden="true"></span>
    <span class="breadcrumb-current" aria-current="page">{post.data.title}</span
    >
  </nav>
  <main class="post container">
    <article>
      <header
        class:list={[
          "post-header",
          {
            "with-image": post.data.image && !post.data.titleModel,
            "with-model": post.data.titleModel,
          },
        ]}
      >
        {
          post.data.titleModel ? (
            <title-model-viewer
              src={post.data.titleModel}
              rotation={post.data.titleModelRotation}
              zoom={post.data.titleModelZoom}
              wireframe={String(post.data.titleModelWireframe)}
              wireframe-style={post.data.titleModelWireframeStyle}
              aria-label={`Interactive 3D model for ${post.data.title}`}
            >
              <a href={post.data.titleModel}>Download the 3D model</a>
            </title-model-viewer>
          ) : (
            post.data.image && (
              <Image
                src={post.data.image}
                alt={post.data.imageAlt}
                width={440}
                class="cover"
                loading="eager"
              />
            )
          )
        }
        <div>
          <h1>{post.data.title}</h1><time
            class="meta"
            datetime={post.data.date.toISOString()}
            >{formatDate(post.data.date)}</time
          >
        </div>
      </header>
      <div class="prose"><Content /></div>
    </article>
  </main>
</Layout>
<script>
  import { whenNearViewport } from "../../scripts/viewer-visibility";
  // Import the engine only when a reader approaches a viewer. Each viewer
  // also gates its own model download, even after its class is registered.
  for (const element of document.querySelectorAll<HTMLElement>(
    "title-model-viewer, wireframe-model-viewer",
  )) {
    whenNearViewport(element, () => {
      const load =
        element.localName === "title-model-viewer"
          ? import("../../scripts/title-model-viewer")
          : import("../../scripts/wireframe-model-viewer");
      // Leave the HTML download link available if the engine cannot load.
      void load.catch((error) =>
        console.error("Unable to load 3D viewer", error),
      );
    });
  }

  const breadcrumb = document.querySelector<HTMLElement>(".breadcrumb");

  if (breadcrumb) {
    let previousScrollY = window.scrollY;
    let ticking = false;

    const updateBreadcrumb = () => {
      const currentScrollY = Math.max(window.scrollY, 0);
      const scrollingDown = currentScrollY > previousScrollY;

      breadcrumb.classList.toggle(
        "breadcrumb-hidden",
        scrollingDown && currentScrollY > 80,
      );
      previousScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateBreadcrumb);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
<style>
  .breadcrumb {
    position: sticky;
    top: 1rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    max-width: calc(100% - 2 * var(--page-gutter));
    min-height: 40px;
    margin: 10px auto 0;
    padding: 8px 12px;
    border: 1px solid var(--color-text);
    background: var(--color-background);
    box-shadow: 0 2px 3px #0003;
    font-size: var(--text-small);
    line-height: 1.5;
    transition:
      transform 220ms ease,
      opacity 180ms ease;
    will-change: transform;
  }
  .breadcrumb-hidden:not(:focus-within) {
    transform: translateY(calc(-100% - 20px));
    opacity: 0;
    pointer-events: none;
  }
  .breadcrumb a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-accent);
  }
  .breadcrumb-separator {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-top: 1px solid var(--color-muted);
    border-right: 1px solid var(--color-muted);
    transform: rotate(45deg);
  }
  .breadcrumb-current {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .post {
    padding: 4rem 0;
  }
  .post-header {
    display: grid;
    align-items: center;
    gap: 32px;
    margin-bottom: 4rem;
  }
  .with-image {
    grid-template-columns: 220px minmax(0, 1fr);
  }
  .with-model {
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 2rem;
  }
  title-model-viewer {
    display: block;
    width: 15rem;
    height: 15rem;
  }
  .cover {
    width: 100%;
    height: 220px;
    object-fit: contain;
  }
  h1 {
    margin: 0 0 12px;
  }

  @media (max-width: 540px) {
    .breadcrumb-hidden:not(:focus-within) {
      transform: translateY(calc(-100% - 14px));
    }
    .with-image {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .post-header.with-model {
      --mobile-model-size: 8rem;
      grid-template-columns: var(--mobile-model-size) minmax(0, 1fr);
    }
    .with-model title-model-viewer {
      width: var(--mobile-model-size);
      height: var(--mobile-model-size);
    }
    .cover {
      width: 180px;
      height: 180px;
    }
    .post-header {
      min-height: 140px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .breadcrumb {
      transition: none;
    }
  }
</style>
