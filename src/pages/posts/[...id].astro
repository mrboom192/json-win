---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";

export async function getStaticPaths() {
  const [blogs, notes] = await Promise.all([
    getCollection("blogs", ({ data }) => !data.draft),
    getCollection("notes", ({ data }) => !data.draft),
  ]);
  const posts = [...blogs, ...notes];
  const ids = new Set<string>();

  for (const post of posts) {
    if (ids.has(post.id)) {
      throw new Error(
        `Duplicate post URL "/posts/${post.id}/". Use unique filenames across blogs and notes.`,
      );
    }
    ids.add(post.id);
  }

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blogs"> | CollectionEntry<"notes">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const postColor = post.data.color;
---

<Layout
  color={post.data.color}
  title={`${post.data.title} | Jason Nguyen`}
  description={post.data.description ?? post.data.title}
>
  <Breadcrumb
    current={post.data.title}
    parents={post.collection === "notes"
      ? [{ label: "Notes", href: "/notes/" }]
      : []}
  />

  <main class="post container">
    <article>
      <header
        class:list={[
          "post-header",
          {
            "with-image": post.data.image && !post.data.titleModel,
            "with-model": post.data.titleModel,
          },
        ]}
      >
        {
          post.data.titleModel ? (
            <title-model-viewer
              src={post.data.titleModel}
              rotation={post.data.titleModelRotation}
              zoom={post.data.titleModelZoom}
              wireframe={String(post.data.titleModelWireframe)}
              wireframe-style={post.data.titleModelWireframeStyle}
              aria-label={`Interactive 3D model for ${post.data.title}`}
            >
              <a href={post.data.titleModel}>Download the 3D model</a>
            </title-model-viewer>
          ) : (
            post.data.image && (
              <Image
                src={post.data.image}
                alt={post.data.imageAlt}
                width={440}
                class="cover"
                loading="eager"
              />
            )
          )
        }

        <div>
          <h1>{post.data.title}</h1>
          <time class="meta" datetime={post.data.date.toISOString()}>
            {
              new Intl.DateTimeFormat("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
                timeZone: "UTC",
              }).format(post.data.date)
            }
          </time>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<!-- Set the post color CSS variable -->
<script is:inline define:vars={{ postColor }}>
  document.documentElement.style.setProperty("--post-color", postColor);
</script>

<script>
  import { whenNearViewport } from "../../scripts/viewer-visibility";

  // Import the engine only when a reader approaches a viewer. Each viewer
  // also gates its own model download, even after its class is registered.
  for (const element of document.querySelectorAll<HTMLElement>(
    "title-model-viewer, wireframe-model-viewer",
  )) {
    whenNearViewport(element, () => {
      const load =
        element.localName === "title-model-viewer"
          ? import("../../scripts/title-model-viewer")
          : import("../../scripts/wireframe-model-viewer");

      // Leave the HTML download link available if the engine cannot load.
      void load.catch((error) =>
        console.error("Unable to load 3D viewer", error),
      );
    });
  }
</script>

<style>
  .post {
    padding: 4rem 0;
  }

  .post-header {
    display: grid;
    align-items: center;
    gap: 32px;
    margin-bottom: 4rem;
  }

  .with-image {
    grid-template-columns: 220px minmax(0, 1fr);
  }

  .with-model {
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 2rem;
  }

  title-model-viewer {
    display: block;
    width: 15rem;
    height: 15rem;
  }

  .cover {
    width: 100%;
    height: 220px;
    object-fit: contain;
  }

  h1 {
    margin: 0 0 12px;
  }

  @media (max-width: 540px) {
    .with-image {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .post-header.with-model {
      --mobile-model-size: 8rem;
      grid-template-columns: var(--mobile-model-size) minmax(0, 1fr);
    }

    .with-model title-model-viewer {
      width: var(--mobile-model-size);
      height: var(--mobile-model-size);
    }

    .cover {
      width: 180px;
      height: 180px;
    }

    .post-header {
      min-height: 140px;
    }
  }
</style>
